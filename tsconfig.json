{
  "compilerOptions": {
    /* Language & environment */
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,

    /* Module resolution */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* JSX */
    "jsx": "react-jsx",

    /* Gradual migration — allows existing .jsx files to coexist with .ts/.tsx */
    "allowJs": true,
    "checkJs": false,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Output — Vite handles the actual emit; tsc is type-check only */
    "noEmit": true,

    /* Vitest globals — provides describe, it, expect, etc. as ambient types.
       jest-dom matchers are loaded via src/test/setup.ts at runtime. */
    "types": ["vitest/globals"]

    /* Path aliases are added in a later task when imports require them */
  },
  "include": ["src"],
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}
