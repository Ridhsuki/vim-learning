{
  "compilerOptions": {
    /* Language & environment for Node/Vite config files */
    "target": "ES2022",
    "lib": ["ES2023"],

    /* Module resolution */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,

    /* No JSX needed in config files */
    "composite": true,
    "noEmit": false,

    /* Strictness */
    "strict": true
  },
  "include": ["vite.config.ts"]
}
